# Environments & deps
.venv/
node_modules/
__pycache__/
tools/

# Media is large: keep it out of git (folders kept via .gitkeep)
media/*/*
!media/*/.gitkeep
exports/*
!exports/.gitkeep
transcripts/*
!transcripts/.gitkeep

