#!/usr/bin/env bash
# Everyday ffmpeg edits. Run `scripts/ff` with no args for the list.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FF=(ffmpeg -hide_banner -loglevel warning -stats -y)
H264=(-c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -c:a aac -b:a 192k -movflags +faststart)

usage() { cat <<'EOF'
scripts/ff <command> ...
  info     <in>                          duration, resolution, fps, codecs
  trim     <in> <start> <end> <out>      cut a section (times like 00:01:05 or 65.5), re-encoded so it's frame-accurate
  concat   <out> <in1> <in2> ...         join clips (re-encodes, so mixed sources are fine)
  vertical <in> <out> [blur|crop]        9:16 1080x1920 for Reels/TikTok/Shorts (blur = blurred background fill)
  subs     <in> <subs.srt> <out>         burn subtitles into the picture
  audio    <in> <out.wav>                extract audio (16 kHz mono for Whisper if out ends in .16k.wav)
  loudnorm <in> <out>                    normalise loudness to -14 LUFS (YouTube/social)
  mix      <video> <music> <out> [vol]   add background music under the original audio (music vol default 0.15)
  speed    <in> <factor> <out>           speed up / slow down (e.g. 1.5 or 0.5), audio pitch kept
  overlay  <base> <overlay.mov> <out>    put a transparent HyperFrames render (MOV/WebM) over footage
  gif      <in> <out.gif> [width]        quick GIF preview
  proxy    <in> <out>                    lightweight 540p editing proxy
  thumbs   <in> <outdir> [every_s]       a still every N seconds (default 5)
  silence  <in> <out>                    remove dead air (auto-editor)
  scenes   <in>                          list shot changes (PySceneDetect)
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  info) ffprobe -v error -show_entries format=duration,size:stream=codec_type,codec_name,width,height,r_frame_rate,sample_rate,channels -of default=nw=1 "$1" ;;
  trim) "${FF[@]}" -ss "$2" -to "$3" -i "$1" "${H264[@]}" "$4" ;;
  concat)
    out="$1"; shift; clips=("$@"); n=${#clips[@]}; inputs=(); filt=""
    for i in $(seq 0 $((n-1))); do
      inputs+=(-i "${clips[$i]}")
      filt+="[$i:v]scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=30[v$i];[$i:a]aresample=48000[a$i];"
    done
    for i in $(seq 0 $((n-1))); do filt+="[v$i][a$i]"; done
    "${FF[@]}" "${inputs[@]}" -filter_complex "${filt}concat=n=$n:v=1:a=1[v][a]" -map "[v]" -map "[a]" "${H264[@]}" "$out" ;;
  vertical)
    if [ "${3:-blur}" = crop ]; then
      "${FF[@]}" -i "$1" -vf "crop=ih*9/16:ih,scale=1080:1920,setsar=1" "${H264[@]}" "$2"
    else
      "${FF[@]}" -i "$1" -filter_complex "[0:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=30:5[bg];[0:v]scale=1080:-2[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2,setsar=1" "${H264[@]}" "$2"
    fi ;;
  subs) "${FF[@]}" -i "$1" -vf "subtitles='$2':force_style='FontSize=18,Outline=2,Shadow=0,MarginV=40'" "${H264[@]}" "$3" ;;
  audio)
    if [[ "$2" == *.16k.wav ]]; then "${FF[@]}" -i "$1" -vn -ac 1 -ar 16000 "$2"; else "${FF[@]}" -i "$1" -vn -c:a pcm_s16le "$2"; fi ;;
  loudnorm) "${FF[@]}" -i "$1" -af "loudnorm=I=-14:TP=-1.5:LRA=11" -c:v copy -c:a aac -b:a 192k "$2" ;;
  mix) "${FF[@]}" -i "$1" -stream_loop -1 -i "$2" -filter_complex "[1:a]volume=${4:-0.15}[m];[0:a][m]amix=inputs=2:duration=first:dropout_transition=2[a]" -map 0:v -map "[a]" -c:v copy -c:a aac -b:a 192k -shortest "$3" ;;
  speed) "${FF[@]}" -i "$1" -filter_complex "[0:v]setpts=PTS/$2[v];[0:a]atempo=$2[a]" -map "[v]" -map "[a]" "${H264[@]}" "$3" ;;
  overlay) "${FF[@]}" -i "$1" -i "$2" -filter_complex "[1:v]scale2ref=iw:ih[ov][base];[base][ov]overlay=0:0:eof_action=pass" -map 0:a? "${H264[@]}" "$3" ;;
  gif) "${FF[@]}" -i "$1" -vf "fps=15,scale=${3:-480}:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" "$2" ;;
  proxy) "${FF[@]}" -i "$1" -vf "scale=-2:540" -c:v libx264 -preset veryfast -crf 26 -c:a aac -b:a 128k "$2" ;;
  thumbs) mkdir -p "$2"; "${FF[@]}" -i "$1" -vf "fps=1/${3:-5}" "$2/thumb_%04d.jpg" ;;
  silence) "$ROOT/.venv/bin/auto-editor" "$1" --margin 0.2s -o "$2" ;;
  scenes) "$ROOT/.venv/bin/scenedetect" -i "$1" detect-adaptive list-scenes -n ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
